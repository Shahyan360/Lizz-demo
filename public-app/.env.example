# Server only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_own_key
LLM_MODEL=gemini-3.5-flash-lite
# A NEW private Blob store belonging only to this demo. No legacy storage.
BLOB_READ_WRITE_TOKEN=replace_with_private_blob_token
# At least 32 random characters. Used only to hash daily anonymous quota identities.
DEMO_QUOTA_SECRET=replace_with_a_random_secret_at_least_32_characters
# Hard server-side upper bound: 100. Default: 40 live calls/day for the entire demo.
DEMO_DAILY_BUDGET=40
DEMO_VISITOR_DAILY_BUDGET=3
CRON_SECRET=replace_with_a_random_secret_at_least_32_characters
