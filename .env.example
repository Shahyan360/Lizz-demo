.
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_MAIL_DOMAIN=mail.zoho.com
ZOHO_WEBHOOK_SECRET=change-me-to-a-long-random-string
SPAM_FILTER_ENABLED=true
ZOHO_FILTERED_FOLDER=Filtered
SPAM_LLM_CHECK=true
ZOHO_SIGNATURE_NAME=
ZOHO_TASK_GROUP_ID=
ZOHO_TASK_PROJECT_ID=

AUTO_SEND_ENABLED=false
CRON_SECRET=change-me-to-a-long-random-string

# In-process scheduler (src/lib/integrations/property-follow-up-scheduler.ts)
# that checks every 30 min for due property follow-ups and sends them. Auto-on
# in production, auto-off elsewhere (dev/test) unless overridden here.
PROPERTY_FOLLOW_UP_SCHEDULER_ENABLED=
# Overrides the 30-min check interval above (e.g. set to 2 for fast local
# testing). Also controls the cron route's dedup-claim window, so it never
# needs to be set in two places.
PROPERTY_FOLLOW_UP_INTERVAL_MINUTES= "40"
